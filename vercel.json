{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/((?!api/.*).*)",
      "destination": "/api/index/$1"
    }
  ],
  "functions": {
    "api/index.py": {
      "excludeFiles": "{tests/**,scripts/**,**/__pycache__/**}",
      "maxDuration": 60
    }
  }
}
